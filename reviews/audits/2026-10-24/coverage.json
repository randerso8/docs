  "findings": [
    {
      "id": "A01",
      "severity": "Medium",
      "title": "Navigation was treated as mandatory release dependency closure",
      "status": "Fixed",
      "resolution": "Removed reading-only dependencies from discovery indexes, roadmap, and technology landing pages; retained actual source prerequisites."
    },
    {
      "id": "A02",
      "severity": "Medium",
      "title": "Applicability seeding and conditional non-applicability were ambiguous",
      "status": "Fixed",
      "resolution": "Specified canonical selectors, both-dimension matching, requirements-bearing seeds, optional pattern/guide handling, and reviewed source-based non-applicability. Exercised two different selections."
    },
    {
      "id": "A03",
      "severity": "Medium",
      "title": "Deprecated guidance had inconsistent new-adoption treatment",
      "status": "Fixed",
      "resolution": "Aligned ownership, release, adoption, and agent instructions: existing use only; new adoption rejects deprecated closure."
    },
    {
      "id": "A04",
      "severity": "Medium",
      "title": "Prohibited personal information conflicted with accountable review identities",
      "status": "Fixed",
      "resolution": "Allowed minimal verified work identifiers while excluding identity proof/personnel/contact/customer material. Clarified local access/backup controls."
    },
    {
      "id": "A05",
      "severity": "High",
      "title": "Candidate preparation/application omitted metadata and revision safeguards",
      "status": "Fixed",
      "resolution": "Validate source metadata before writing a package and reject revision decreases at application. Two reproduced regressions."
    },
    {
      "id": "A06",
      "severity": "High",
      "title": "Required review roles could be weakened and critical controls depended on paths",
      "status": "Fixed",
      "resolution": "Preserve required roles within a request; protect lifecycle/release/security control IDs after moves; require previous role authority for reviewed policy changes. Three regression cases."
    },
    {
      "id": "A07",
      "severity": "Medium",
      "title": "Current reviewer changes could invalidate immutable retired history",
      "status": "Fixed",
      "resolution": "Keep structural historical evidence checks; use pinned historical authority. New retirement still requires current delegated approval against a baseline. Compare both review and last-release snapshots. Two regressions."
    },
    {
      "id": "A08",
      "severity": "Medium",
      "title": "Nested work directories could hide governed documents from scanning",
      "status": "Fixed",
      "resolution": "Limit scratch exclusions to repository-root work/outputs; scan nested governed folders. Reproduced regression."
    },
    {
      "id": "A09",
      "severity": "Low",
      "title": "The approved-release pointer accepted arbitrary strings",
      "status": "Fixed",
      "resolution": "Constrain pointer to a numeric version tag or null. Shape regression; actual Git tag/snapshot verification remains a separate step."
    },
    {
      "id": "A10",
      "severity": "Medium",
      "title": "Bearer API 401 responses omitted the required challenge",
      "status": "Fixed",
      "resolution": "Add WWW-Authenticate to both 401 responses and enforce it in the fixture checker. Also specify malformed-path and unexpected GET errors. Reproduced negative test."
    },
    {
      "id": "A11",
      "severity": "Medium",
      "title": "Request-level CSRF behavior was underspecified for automatic credentials",
      "status": "Fixed",
      "resolution": "Clarify the identity requirement and Spring evidence for cookie/browser-automatic credentials; no browser-session architecture selected."
    },
    {
      "id": "A12",
      "severity": "Low",
      "title": "An example environment observation sounded permanently current",
      "status": "Fixed",
      "resolution": "Date the initial toolchain/container observation and retain pending runtime status."
    },
    {
      "id": "A13",
      "severity": "Low",
      "title": "Inactive hosted checks omitted the newer example consistency check",
      "status": "Fixed",
      "resolution": "Align optional workflow/review template with required local checks; keep hosting inactive."
    }
  ],
