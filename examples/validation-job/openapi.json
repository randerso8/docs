{
  "openapi": "3.1.1",
  "info": {
    "title": "Synthetic dataset-validation job API",
    "version": "0.1.0-draft",
    "description": "Internal design fixture. Not a deployed API or an approved standards release. Runtime and full contract validation are pending."
  },
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "Synthetic documentation address only"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/validation-jobs": {
      "post": {
        "operationId": "submitValidationJob",
        "summary": "Durably accept a validation job",
        "description": "Tenant and actor come from validated server context, not the body. A new committed job returns 202/PENDING. An authorized replay of the same scoped key and canonical input returns 200 with the existing current job. Reuse for different input returns 409. Idempotency-Key is an application contract here, not a claim of a universal HTTP standard. Admission is bounded by application policy.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Stable for one immutable user intent. Scope: tenant, authenticated actor, and this submission operation.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            "example": "sample-operation-0001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateValidationJob"
              },
              "example": {
                "datasetId": "sample-alpha",
                "datasetVersion": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized replay of an existing job; no second job is created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "202": {
            "description": "A new PENDING job is committed. This does not mean the validation completed.",
            "headers": {
              "Location": {
                "description": "Same-origin relative status URL; clients validate destinations before attaching credentials.",
                "schema": {
                  "type": "string",
                  "pattern": "^/v1/validation-jobs/[0-9a-f-]{36}$"
                }
              },
              "Retry-After": {
                "description": "Illustrative polling hint in seconds, bounded by client policy; no organization-wide interval is selected.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "example": "2"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingJob"
                },
                "example": {
                  "jobId": "11111111-1111-4111-8111-111111111111",
                  "datasetId": "sample-alpha",
                  "datasetVersion": 1,
                  "createdAt": "2026-10-23T13:00:00Z",
                  "status": "PENDING"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request/header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Applicable Bearer authentication challenge. Do not include tokens, internal diagnostics, or unsafe descriptions.",
                "schema": {
                  "type": "string"
                },
                "example": "Bearer realm=\"validation-api\""
              }
            }
          },
          "403": {
            "description": "Authenticated principal lacks submission permission.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The selected input is unavailable to the principal; do not distinguish inaccessible from absent resources.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Same scoped operation key reused for different canonical input.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Request size limit exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Admission/rate/capacity budget exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Safe unexpected failure; an ambiguous commit is recovered using the same key and immutable input.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service cannot admit work; retry only under bounded policy with the same intent key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/validation-jobs/{jobId}": {
      "get": {
        "operationId": "getValidationJob",
        "summary": "Read an authorized job status",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current state. PENDING may include work active inside an uncommitted short transaction.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                },
                "examples": {
                  "pending": {
                    "value": {
                      "jobId": "11111111-1111-4111-8111-111111111111",
                      "datasetId": "sample-alpha",
                      "datasetVersion": 1,
                      "createdAt": "2026-10-23T13:00:00Z",
                      "status": "PENDING"
                    }
                  },
                  "succeeded": {
                    "value": {
                      "jobId": "11111111-1111-4111-8111-111111111111",
                      "datasetId": "sample-alpha",
                      "datasetVersion": 1,
                      "createdAt": "2026-10-23T13:00:00Z",
                      "status": "SUCCEEDED",
                      "completedAt": "2026-10-23T13:00:01Z",
                      "result": {
                        "totalCount": 3,
                        "invalidCount": 1
                      }
                    }
                  },
                  "failed": {
                    "value": {
                      "jobId": "11111111-1111-4111-8111-111111111111",
                      "datasetId": "sample-alpha",
                      "datasetVersion": 1,
                      "createdAt": "2026-10-23T13:00:00Z",
                      "status": "FAILED",
                      "completedAt": "2026-10-23T13:01:00Z",
                      "failureCode": "OPERATOR_ABORTED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed jobId path parameter.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Applicable Bearer authentication challenge. Do not include tokens, internal diagnostics, or unsafe descriptions.",
                "schema": {
                  "type": "string"
                },
                "example": "Bearer realm=\"validation-api\""
              }
            }
          },
          "403": {
            "description": "Principal lacks status-read permission.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Absent job or a job outside the authorized tenant/actor scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Polling budget exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Safe unexpected status-read failure; this does not make the job FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Status temporarily unavailable; this does not indicate job failure.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Example bearer-token boundary only. Issuer, audience, claim mapping and browser session design are not selected by this fixture."
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CreateValidationJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "datasetId": {
            "type": "string",
            "pattern": "^sample-[a-z0-9][a-z0-9-]{0,39}$"
          },
          "datasetVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "datasetId",
          "datasetVersion"
        ]
      },
      "Job": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PendingJob"
          },
          {
            "$ref": "#/components/schemas/SucceededJob"
          },
          {
            "$ref": "#/components/schemas/FailedJob"
          }
        ]
      },
      "PendingJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "datasetId": {
            "type": "string",
            "pattern": "^sample-[a-z0-9][a-z0-9-]{0,39}$"
          },
          "datasetVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "const": "PENDING"
          }
        },
        "required": [
          "jobId",
          "datasetId",
          "datasetVersion",
          "createdAt",
          "status"
        ]
      },
      "SucceededJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "datasetId": {
            "type": "string",
            "pattern": "^sample-[a-z0-9][a-z0-9-]{0,39}$"
          },
          "datasetVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "const": "SUCCEEDED"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "$ref": "#/components/schemas/ValidationResult"
          }
        },
        "required": [
          "jobId",
          "datasetId",
          "datasetVersion",
          "createdAt",
          "status",
          "completedAt",
          "result"
        ]
      },
      "FailedJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "datasetId": {
            "type": "string",
            "pattern": "^sample-[a-z0-9][a-z0-9-]{0,39}$"
          },
          "datasetVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "const": "FAILED"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "failureCode": {
            "type": "string",
            "enum": [
              "INPUT_UNAVAILABLE",
              "RETRY_EXHAUSTED",
              "OPERATOR_ABORTED"
            ]
          }
        },
        "required": [
          "jobId",
          "datasetId",
          "datasetVersion",
          "createdAt",
          "status",
          "completedAt",
          "failureCode"
        ]
      },
      "ValidationResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "totalCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "invalidCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "totalCount",
          "invalidCount"
        ],
        "description": "invalidCount is no greater than totalCount. A completed validation may find invalid records and still have job status SUCCEEDED."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": true,
        "description": "Safe RFC 9457-style body. No raw exception, token, dataset payload, or credential. Extensions are governed by the application contract."
      }
    }
  }
}
