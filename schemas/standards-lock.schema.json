{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed immutable standards pin",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(https://|ssh://|git@|file:///)"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{40}$"
    },
    "manifest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^releases/manifests/[0-9]+\\.[0-9]+\\.[0-9]+\\.json$"
    }
  },
  "required": [
    "repository",
    "release",
    "commit",
    "manifest"
  ],
  "additionalProperties": false
}
